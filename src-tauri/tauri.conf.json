{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluffyChat Portable",
  "version": "2.8.0",
  "identifier": "im.fluffychat.portable",
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
